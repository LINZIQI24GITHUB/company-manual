{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinanSI Company Manual",
  "type": "object",
  "required": [
    "slug", "locale", "name", "legal_name", "ticker", "exchange",
    "currency", "unit", "fy_label", "fy_end", "business",
    "key_facts", "financials", "sources"
  ],
  "properties": {
    "slug": { "type": "string" },
    "locale": { "enum": ["en", "zh"] },
    "name": { "type": "string" },
    "legal_name": { "type": "string" },
    "name_en": { "type": "string" },
    "ticker": { "type": "string" },
    "exchange": { "type": "string" },
    "currency": { "type": "string" },
    "unit": { "type": "string" },
    "symbol": { "type": "string" },
    "fy_label": { "type": "string" },
    "fy_end": { "type": "string" },
    "founded": { "type": "string" },
    "listed": { "type": "string" },
    "hq": { "type": "string" },
    "employees": { "type": "string" },
    "chairman": { "type": "string" },
    "auditor": { "type": "string" },
    "industry": { "type": "string" },
    "business": { "type": "string" },
    "business_pillars": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string" }
      }
    },
    "key_facts": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string" }
      }
    },
    "financials": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["year", "revenue", "net_income"],
        "properties": {
          "year": { "type": "string" },
          "revenue": { "type": ["number", "null"] },
          "gross_profit": { "type": ["number", "null"] },
          "operating_income": { "type": ["number", "null"] },
          "net_income": { "type": ["number", "null"] },
          "assets": { "type": ["number", "null"] },
          "liabilities": { "type": ["number", "null"] },
          "equity": { "type": ["number", "null"] },
          "total_equity": { "type": ["number", "null"] },
          "cash": { "type": ["number", "null"] },
          "debt": { "type": ["number", "null"] },
          "ocf": { "type": ["number", "null"] },
          "capex": { "type": ["number", "null"] },
          "dividends": { "type": ["number", "null"] },
          "buybacks": { "type": ["number", "null"] },
          "roe": { "type": ["number", "null"] },
          "eps": { "type": ["number", "null"] }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "revenue", "share", "gm"],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "revenue": { "type": "number" },
          "share": { "type": "number" },
          "gm": { "type": "number" }
        }
      }
    },
    "capital_note": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string" }
      }
    }
  }
}
